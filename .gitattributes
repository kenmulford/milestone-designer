# Normalize line endings in the repository to LF.
* text=auto

# Shell scripts MUST be LF even in the working tree — CRLF breaks the shebang
# and produces "bad interpreter" / "\r command not found" on Linux, macOS, WSL,
# and git-bash. scripts/check-skill-size.sh is invoked directly by CI
# (ubuntu-latest), so a CRLF checkout on a Windows dev machine must not leak in.
*.sh text eol=lf

# PowerShell scripts: keep LF too for clean cross-platform diffs.
# pwsh 7+ runs LF scripts fine on Windows, Linux, and macOS.
*.ps1 text eol=lf
